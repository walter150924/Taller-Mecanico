<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import com.taller.mecanico.ui.WcPaginador?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.taller.mecanico.controller.WcClienteController"
      styleClass="pagina">

    <fx:define>
        <VBox fx:id="wcPanelFormulario" styleClass="drawer"
              prefWidth="440.0" maxWidth="440.0" maxHeight="Infinity">
            <HBox styleClass="drawer-header">
                <StackPane styleClass="drawer-icono"><FontIcon iconLiteral="fth-user"/></StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="wcLblTituloFormulario" text="Nuevo cliente" styleClass="drawer-titulo"/>
                    <Label fx:id="wcLblSubtituloFormulario" text="Completa los datos para registrarla"
                           styleClass="drawer-subtitulo"/>
                </VBox>
                <Button onAction="#wcOnCerrarFormulario" styleClass="flat,button-circle">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="drawer-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="drawer-body">
                    <Label text="IDENTIFICACION" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="DNI *" styleClass="campo-label"/>
                        <CustomTextField fx:id="wcTxtDni" promptText="8 digitos">
                            <left><FontIcon iconLiteral="fth-credit-card"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Nombre *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtNombre" promptText="Ej. Maria"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Apellido *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtApellido" promptText="Ej. Quispe"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <Label text="CONTACTO" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Correo electronico" styleClass="campo-label"/>
                        <CustomTextField fx:id="wcTxtEmail" promptText="nombre@correo.com">
                            <left><FontIcon iconLiteral="fth-mail"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <VBox styleClass="campo">
                        <Label text="Telefono" styleClass="campo-label"/>
                        <CustomTextField fx:id="wcTxtTelefono" promptText="9 digitos">
                            <left><FontIcon iconLiteral="fth-phone"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <HBox styleClass="drawer-footer">
                <Button text="Cancelar" onAction="#wcOnCerrarFormulario" styleClass="button-outlined"/>
                <Button text="Guardar" onAction="#wcOnGuardar" styleClass="accent" defaultButton="true">
                    <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </fx:define>

    <HBox styleClass="pagina-cabecera">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Clientes" styleClass="pagina-titulo"/>
            <Label text="Administra los clientes del taller y sus datos de contacto"
                   styleClass="pagina-subtitulo"/>
        </VBox>
        <Button text="Nuevo cliente" onAction="#wcOnNuevo" styleClass="accent,boton-principal">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox styleClass="barra-herramientas">
            <CustomTextField fx:id="wcTxtBuscar" promptText="Buscar por nombre, apellido o DNI"
                             styleClass="buscador" prefWidth="340.0">
                <left><FontIcon iconLiteral="fth-search"/></left>
            </CustomTextField>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="wcBtnEditar" text="Editar" onAction="#wcOnEditar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
            </Button>
            <Button fx:id="wcBtnEliminar" text="Eliminar" onAction="#wcOnEliminar"
                    styleClass="button-outlined,danger">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="wcTabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="wcColId"       text="ID"        prefWidth="70.0"  maxWidth="90.0"/>
                <TableColumn fx:id="wcColNombre"   text="CLIENTE"   prefWidth="260.0"/>
                <TableColumn fx:id="wcColDni"      text="DNI"       prefWidth="120.0"/>
                <TableColumn fx:id="wcColEmail"    text="CORREO"    prefWidth="240.0"/>
                <TableColumn fx:id="wcColTelefono" text="TELEFONO"  prefWidth="130.0"/>
            </columns>
        </TableView>

        <WcPaginador fx:id="wcPaginador"/>
    </VBox>
</VBox>
