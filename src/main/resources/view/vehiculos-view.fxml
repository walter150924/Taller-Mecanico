<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.CustomTextField?>
<?import com.taller.mecanico.ui.WcPaginador?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.taller.mecanico.controller.WcVehiculoController"
      styleClass="pagina">

    <fx:define>
        <VBox fx:id="wcPanelFormulario" styleClass="drawer"
              prefWidth="460.0" maxWidth="460.0" maxHeight="Infinity">
            <HBox styleClass="drawer-header">
                <StackPane styleClass="drawer-icono"><FontIcon iconLiteral="fth-truck"/></StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="wcLblTituloFormulario" text="Nuevo vehiculo" styleClass="drawer-titulo"/>
                    <Label fx:id="wcLblSubtituloFormulario" text="Registra el vehiculo y su propietario"
                           styleClass="drawer-subtitulo"/>
                </VBox>
                <Button onAction="#wcOnCerrarFormulario" styleClass="flat,button-circle">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="drawer-scroll" VBox.vgrow="ALWAYS">
                <VBox styleClass="drawer-body">
                    <Label text="PROPIETARIO" styleClass="seccion-form"/>

                    <VBox styleClass="campo">
                        <Label text="Cliente *" styleClass="campo-label"/>
                        <CustomTextField fx:id="wcTxtCliente" promptText="Busca por DNI o nombre">
                            <left><FontIcon iconLiteral="fth-user"/></left>
                        </CustomTextField>
                        <Label styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <Label text="VEHICULO" styleClass="seccion-form"/>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Placa *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtPlaca" promptText="ABC-123"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Año *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtAnio" promptText="Ej. 2018"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Marca *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtMarca" promptText="Ej. Toyota"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Modelo *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtModelo" promptText="Ej. Yaris"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="14.0">
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Color" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtColor" promptText="Ej. Plata"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                        <VBox styleClass="campo" HBox.hgrow="ALWAYS">
                            <Label text="Kilometraje *" styleClass="campo-label"/>
                            <TextField fx:id="wcTxtKilometraje" promptText="Ej. 45000"/>
                            <Label styleClass="campo-error" visible="false" managed="false"/>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>

            <HBox styleClass="drawer-footer">
                <Button text="Cancelar" onAction="#wcOnCerrarFormulario" styleClass="button-outlined"/>
                <Button text="Guardar" onAction="#wcOnGuardar" styleClass="accent" defaultButton="true">
                    <graphic><FontIcon iconLiteral="fth-check"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <VBox fx:id="wcPanelHistorial" styleClass="drawer"
              prefWidth="640.0" maxWidth="640.0" maxHeight="Infinity">
            <HBox styleClass="drawer-header">
                <StackPane styleClass="drawer-icono"><FontIcon iconLiteral="fth-clock"/></StackPane>
                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                    <Label fx:id="wcLblTituloHistorial" styleClass="drawer-titulo"/>
                    <Label fx:id="wcLblSubtituloHistorial" styleClass="drawer-subtitulo"/>
                </VBox>
                <Button onAction="#wcOnCerrarFormulario" styleClass="flat,button-circle">
                    <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                </Button>
            </HBox>
            <VBox styleClass="drawer-body" VBox.vgrow="ALWAYS">
                <TableView fx:id="wcTablaHistorial" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="wcColHistCodigo"      text="ORDEN"      prefWidth="100.0"/>
                        <TableColumn fx:id="wcColHistFecha"       text="INGRESO"    prefWidth="120.0"/>
                        <TableColumn fx:id="wcColHistKilometraje" text="KM"         prefWidth="90.0"/>
                        <TableColumn fx:id="wcColHistDiagnostico" text="TRABAJO"    prefWidth="200.0"/>
                        <TableColumn fx:id="wcColHistEstado"      text="ESTADO"     prefWidth="130.0"/>
                        <TableColumn fx:id="wcColHistTotal"       text="TOTAL"      prefWidth="100.0"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </fx:define>

    <HBox styleClass="pagina-cabecera">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label text="Vehiculos" styleClass="pagina-titulo"/>
            <Label text="Vehiculos de los clientes y su historial de servicios" styleClass="pagina-subtitulo"/>
        </VBox>
        <Button text="Nuevo vehiculo" onAction="#wcOnNuevo" styleClass="accent,boton-principal">
            <graphic><FontIcon iconLiteral="fth-plus"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox styleClass="barra-herramientas">
            <CustomTextField fx:id="wcTxtBuscar" promptText="Buscar por placa, marca, modelo o propietario"
                             styleClass="buscador" prefWidth="380.0">
                <left><FontIcon iconLiteral="fth-search"/></left>
            </CustomTextField>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="wcBtnHistorial" text="Historial" onAction="#wcOnHistorial" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-clock"/></graphic>
            </Button>
            <Button fx:id="wcBtnEditar" text="Editar" onAction="#wcOnEditar" styleClass="button-outlined">
                <graphic><FontIcon iconLiteral="fth-edit-2"/></graphic>
            </Button>
            <Button fx:id="wcBtnEliminar" text="Eliminar" onAction="#wcOnEliminar"
                    styleClass="button-outlined,danger">
                <graphic><FontIcon iconLiteral="fth-trash-2"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="wcTabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="wcColPlaca"       text="PLACA"        prefWidth="110.0"/>
                <TableColumn fx:id="wcColVehiculo"    text="VEHICULO"     prefWidth="240.0"/>
                <TableColumn fx:id="wcColPropietario" text="PROPIETARIO"  prefWidth="260.0"/>
                <TableColumn fx:id="wcColColor"       text="COLOR"        prefWidth="110.0"/>
                <TableColumn fx:id="wcColKilometraje" text="KILOMETRAJE"  prefWidth="130.0"/>
            </columns>
        </TableView>

        <WcPaginador fx:id="wcPaginador"/>
    </VBox>
</VBox>
